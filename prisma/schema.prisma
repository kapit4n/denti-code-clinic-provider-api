// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Specialization {
  SpecializationID    Int        @id @default(autoincrement())
  SpecializationName  String     @unique
  Description         String?
  doctors             Doctor[]   // Relation to Doctor model
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Doctor {
  DoctorID            Int        @id @default(autoincrement())
  FirstName           String
  LastName            String
  LicenseNumber       String     @unique
  ContactPhone        String     @unique
  Email               String     @unique
  AvatarUrl           String?
  OfficeRoomNumber    String?
  IsActive            Boolean    @default(true)
  SpecializationID    Int?       // Foreign key for Specialization
  specialization      Specialization? @relation(fields: [SpecializationID], references: [SpecializationID])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model ProcedureCategory {
  CategoryID        Int             @id @default(autoincrement())
  CategoryName      String          @unique
  Description       String?
  procedureTypes    ProcedureType[] // Relation to ProcedureType model
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ProcedureType {
  ProcedureTypeID             Int       @id @default(autoincrement())
  ProcedureName               String    @unique
  Description                 String?
  DefaultDurationMinutes    Int?
  StandardPrice               Float?    // Use Float for currency or Decimal if your DB supports it well with Prisma
  RequiresToothSpecification  Boolean   @default(false)
  IsActive                    Boolean   @default(true)
  CategoryID                  Int       // Foreign key for ProcedureCategory
  category                    ProcedureCategory @relation(fields: [CategoryID], references: [CategoryID])
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

/// Materials, equipment, and PPE used during treatments (referenced by appointments service via stable FacilityCode).
model TreatmentFacility {
  FacilityID    Int      @id @default(autoincrement())
  FacilityCode  String   @unique
  CategoryKey   String
  DisplayName   String
  SortOrder     Int      @default(0)
  IsActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  inventoryLines MaterialInventoryLine[]
  inventoryMovements InventoryMovement[]
}

/// Operatory / consultory where consumable stock is tracked (per treatment-facility catalog item).
model Consultory {
  ConsultoryID Int      @id @default(autoincrement())
  Name         String
  ShortCode    String?  @unique
  SortOrder    Int      @default(0)
  IsActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  inventoryLines MaterialInventoryLine[]
  inventoryMovements InventoryMovement[]
}

/// On-hand quantity of a catalog material at a specific consultory.
model MaterialInventoryLine {
  LineID       Int      @id @default(autoincrement())
  ConsultoryID Int
  FacilityID   Int
  Quantity     Int      @default(0)
  consultory   Consultory       @relation(fields: [ConsultoryID], references: [ConsultoryID])
  facility     TreatmentFacility @relation(fields: [FacilityID], references: [FacilityID])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ConsultoryID, FacilityID])
}

enum InventoryMovementType {
  RECEIVE
  REMOVE
  CONSUME
}

/// Audit trail for stock changes (receive, waste/remove, clinical consume).
model InventoryMovement {
  MovementID     Int                   @id @default(autoincrement())
  ConsultoryID   Int
  FacilityID     Int
  QuantityChange Int
  Type           InventoryMovementType
  Note           String?
  consultory     Consultory       @relation(fields: [ConsultoryID], references: [ConsultoryID])
  facility       TreatmentFacility @relation(fields: [FacilityID], references: [FacilityID])
  createdAt      DateTime @default(now())
}
